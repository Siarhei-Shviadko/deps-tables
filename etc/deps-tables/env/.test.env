# Blob storage
# File Storage (default)
BLOB_STORAGE=FILE_STORAGE
# File Blob storage service
FILE_STORAGE_URL=http://file-storage-nginx:8000/api/storage/v1/file
VERIFY_SSL=false

# Auth
AUTH_ENABLED=false
AUTH_VERIFY_SSL=false

OCR_API_URL=http://ocr:8000/api/ocr/v1/extract-text
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=

AZURE_FORM_RECOGNIZER_API=
AZURE_FORM_RECOGNIZER_KEY=

GCP_PROJECT_ID=
GCP_LOCATION=eu
GCP_PROCESSOR_ID=
GCP_API_KEY='{}'

PROJECT_VERSION=0.3.0
PREINIT_DETECTORS=false

# Gunicorn settings

## Number of workers
WORKERS=1
## Reload worker if any code changes
RELOAD=true
## Level of displayed logs
LOG_LEVEL=info
## Maximum number of requests that worker can handle
MAX_REQUESTS=1000
## Timeout for one request (in seconds)
TIMEOUT=600

# Sentry settings
SENTRY_ENABLED=false
SENTRY_DSN=

## Set debug to true for local development and running
DEBUG=false

# Machine learning models settings
ENABLE_GPU=false
# border identification allows to verify that image has at least one table
# and it means that we can get coordinates of this table
IDENTIFY_TABLE_BORDERS=true

## List of enabled table detection engines
ENABLED_DETECTION_ENGINES=["DEPS_DETECTOR"]
PAID_ENGINES_RESTRICTION_ENABLED=false

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@test-rabbitmq:5672/test_deps

# Kafka
KAFKA_GROUP_ID=tables
